    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
    <Color x:Key="AccentPressedColor">#1E40AF</Color>
    <SolidColorBrush x:Key="AccentPressed" Color="#1E40AF" />
    <Color x:Key="SoftColor">#14294F</Color>
    <SolidColorBrush x:Key="Soft" Color="#14294F" />
    <Color x:Key="SelectionColor">#1D3B72</Color>
    <SolidColorBrush x:Key="Selection" Color="#1D3B72" />
    <Color x:Key="SuccessColor">#22C55E</Color>
    <SolidColorBrush x:Key="Success" Color="#22C55E" />
    <Color x:Key="DangerColor">#F87171</Color>
    <SolidColorBrush x:Key="Danger" Color="#F87171" />
