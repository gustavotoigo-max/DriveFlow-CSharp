<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta do tema escuro; mesmos valores do theme.py da versão Python. -->
    <Color x:Key="BgColor">#0A1222</Color>
    <SolidColorBrush x:Key="Bg" Color="#0A1222" />
    <Color x:Key="SurfaceColor">#111B2E</Color>
    <SolidColorBrush x:Key="Surface" Color="#111B2E" />
    <Color x:Key="AltColor">#16223A</Color>
    <SolidColorBrush x:Key="Alt" Color="#16223A" />
    <Color x:Key="BorderColor">#24324E</Color>
    <SolidColorBrush x:Key="Border" Color="#24324E" />
